val wand = <item.extrautils:creativebuilderswand>;
val unstableIngot = <item.extrautils:unstableingot>;
val netherStar = <item.netherStar>;
val stick = <item.stick>;

recipes.addShaped(wand, [
  [unstableIngot, unstableIngot, unstableIngot],
  [netherStar, stick, netherStar],
  [netherStar, netherStar, netherStar]
]);
